# Backend environment. Copy to backend/.env, export before `python backend/app.py`,
# or paste the values into Render. NEVER commit real credentials.

PORT=10000
DEV_MODE=false

# HMAC key for session tokens and websocket tickets (long random string)
AUTH_SECRET=

# Comma-separated allowed browser origins
FRONTEND_ORIGIN=https://your-frontend.example.com

# ---- Firebase Admin (service account; keep off the frontend) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# ---- Telegram Mini App (bot token stays server side) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_REQUIRED=true
TELEGRAM_INIT_DATA_TTL=86400

# Server-side role assignment (numeric Telegram user ids)
OWNER_TELEGRAM_IDS=
MODERATOR_TELEGRAM_IDS=

# ---- Rooms ----
MAX_PARTICIPANTS=20
DEFAULT_ROOM_ID=gossip-main
DEFAULT_ROOM_TITLE=Gossip
DEFAULT_ROOM_EMOJI=💬
ALLOW_ROOM_AUTOCREATE=false
KICK_COOLDOWN_SECONDS=60

# ---- Chat ----
CHAT_ENABLED=true
MAX_CHAT_LENGTH=500
MAX_CHAT_HISTORY=50

# ---- WebSocket / heartbeat ----
WS_PING_INTERVAL=25
WS_STALE_AFTER_SECONDS=90
MAX_WS_MESSAGE_BYTES=65536

# ---- Abuse protection ----
MAX_CONNECTIONS_PER_IP=8
MAX_CONNECTIONS_PER_USER=3

# ---- Token lifetimes ----
SESSION_TTL_SECONDS=3600
TICKET_TTL_SECONDS=75
